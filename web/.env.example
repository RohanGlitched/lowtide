# Vercel Blob store (private) for households and the daily model budget. Without it, data goes to web/.data/.
BLOB_READ_WRITE_TOKEN=
# Amazon Bedrock API key for the Echo simulator's language model. Without it, the built-in phrase router answers.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Model calls allowed per day across all visitors (default 1500).
DAILY_MODEL_CAP=1500
NEXT_PUBLIC_SITE_URL=https://lowtide-energy.vercel.app
