# Where households and the daily model budget live: a private Google Cloud Storage bucket, reached keylessly
# (a workload identity provider that trusts Vercel's OIDC issuer; the bucket role is granted to
# principal://iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/subject/owner:<team>:project:<project>:environment:production),
# or a Vercel Blob store. Without either, data goes to web/.data/.
GCS_BUCKET=
GCS_WIF_AUDIENCE=//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
BLOB_READ_WRITE_TOKEN=
# Amazon Bedrock for the Echo simulator's language model, called with SigV4-signed requests only. Use an IAM user
# that may call bedrock:InvokeModel on Nova Micro and Nova Lite and nothing else. Without credentials, the
# built-in phrase router answers.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=ap-southeast-2
# Default: Amazon Nova Micro through the region's inference profile (apac., eu. or us.), then Nova Lite.
BEDROCK_MODEL=
# Model calls allowed per day across all visitors (default 1500).
DAILY_MODEL_CAP=1500
NEXT_PUBLIC_SITE_URL=https://lowtide-energy.vercel.app
