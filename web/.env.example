# Vercel Blob store (private) for households and the daily model budget. Without it, data goes to web/.data/.
BLOB_READ_WRITE_TOKEN=
# Amazon Bedrock for the Echo simulator's language model. Without credentials, the built-in phrase router answers.
# Either IAM credentials (signed requests; an IAM user that may only call bedrock:InvokeModel on Nova Micro and Nova Lite)...
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# ...or a Bedrock API key, if your AWS organisation allows them.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=ap-southeast-2
# Default: Amazon Nova Micro through the region's inference profile (apac., eu. or us.), then Nova Lite.
BEDROCK_MODEL=
# Model calls allowed per day across all visitors (default 1500).
DAILY_MODEL_CAP=1500
NEXT_PUBLIC_SITE_URL=https://lowtide-energy.vercel.app
