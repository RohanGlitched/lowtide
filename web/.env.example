# Where households and the daily model budget live: a private Amazon S3 bucket (block all public access), in the
# same region as Bedrock. Credentials: AWS_ROLE_ARN for a role that trusts Vercel's OIDC issuer (keyless), or,
# where the organisation forbids IAM OIDC providers, the key of an IAM user whose only policy is
# s3:GetObject/PutObject/DeleteObject on the bucket's objects and s3:ListBucket on the bucket.
# A Google Cloud Storage bucket (GCS_BUCKET + GCS_WIF_AUDIENCE) or a Vercel Blob store also work.
# Without any store, data goes to web/.data/.
S3_BUCKET=
S3_REGION=ap-southeast-2
AWS_ROLE_ARN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GCS_BUCKET=
GCS_WIF_AUDIENCE=
BLOB_READ_WRITE_TOKEN=
# Amazon Bedrock for the Echo simulator's language model, called with SigV4-signed requests only. Use an IAM user
# that may call bedrock:InvokeModel on Nova Micro and Nova Lite and nothing else. Without credentials, the
# built-in phrase router answers.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=ap-southeast-2
# Default: Amazon Nova Micro through the region's inference profile (apac., eu. or us.), then Nova Lite.
BEDROCK_MODEL=
# Model calls allowed per day across all visitors (default 1500).
DAILY_MODEL_CAP=1500
NEXT_PUBLIC_SITE_URL=https://lowtide-energy.vercel.app
